{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress dev",
        "cwd": "apps/docs"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress build",
        "cwd": "apps/docs"
      },
      "outputs": ["{projectRoot}/.vitepress/dist"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress preview",
        "cwd": "apps/docs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress serve",
        "cwd": "apps/docs"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/docs/**/*.{ts,tsx,js,jsx,vue,md}"]
      }
    }
  },
  "tags": ["scope:docs", "type:app"]
}