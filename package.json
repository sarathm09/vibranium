{
  "name": "vibranium-cli",
  "version": "0.1.0",
  "description": "API testing and data generation made easy",
  "author": "sarathm09",
  "main": "src/index.js",
  "licence": "ISC",
  "homepage": "https://sarathm09.github.io/vibranium/",
  "engines": {
    "node": ">=18.0"
  },
  "keywords": [
    "vibranium",
    "api",
    "functional",
    "regression",
    "test",
    "data generation",
    "schema"
  ],
  "bin": {
    "vibranium": "src/app/cli.js",
    "vc": "src/app/cli.js"
  },
  "scripts": {
    "build": "npm run build:working",
    "build:working": "npx nx build types && npx nx build http-client && npx nx build ui && npx nx build docs",
    "build:all": "nx run-many --target=build --all --skip-nx-cache",
    "build:cli": "npx nx build cli",
    "dev": "npx tsx packages/cli/src/bin/vibranium.ts",
    "test": "nx run-many --target=test --projects=types,http-client",
    "test:all": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --projects=types,http-client,ui",
    "lint:all": "nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "nx reset && find packages -name 'dist' -type d -exec rm -rf {} + || true",
    "nx": "nx",
    "cli:link": "npm run build:working && cd packages/cli && npm link",
    "cli:unlink": "npm unlink -g @vibraniumjs/cli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarathm09/vibranium.git"
  },
  "bugs": {
    "url": "https://github.com/sarathm09/vibranium/issues"
  },
  "dependencies": {
    "@types/glob": "^8.1.0",
    "@types/inquirer": "^9.0.8",
    "@xmldom/xmldom": "^0.9.8",
    "ajv": "^6.12.5",
    "ajv-formats": "^3.0.1",
    "axios": "^0.21.1",
    "browser-or-node": "^1.2.1",
    "chai-as-promised": "^7.1.1",
    "chalk": "^3.0.0",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "express-rate-limit": "^5.1.3",
    "fast-glob": "^3.3.3",
    "figures": "^6.1.0",
    "got": "^13.0.0",
    "ink": "^5.2.1",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^10.3.0",
    "lorem-ipsum": "^2.0.3",
    "nedb": "^1.8.0",
    "node-fetch": "^2.6.1",
    "open": "^7.3.0",
    "ora": "^4.1.1",
    "pretty-ms": "^6.0.1",
    "randexp": "^0.5.3",
    "request": "^2.88.0",
    "treeify": "^1.1.0",
    "uuid": "^3.3.3",
    "vibranium-report-ui": "^0.0.6",
    "vm2": "^3.8.4",
    "xmlbuilder2": "^1.7.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@nx/eslint": "^21.3.0",
    "@nx/eslint-plugin": "^21.3.0",
    "@nx/jest": "^21.3.0",
    "@nx/js": "^21.3.0",
    "@nx/vite": "^21.3.0",
    "@nx/workspace": "^21.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.0.15",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.3.4",
    "chai": "^4.2.0",
    "crypto-js": "^4.2.0",
    "eslint": "^8.57.1",
    "jest": "^30.0.4",
    "mocha": "^7.2.0",
    "node-forge": ">=0.10.0",
    "nx": "21.3.0",
    "nyc": "^15.1.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sinon": "^9.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitepress": "^1.6.3",
    "vue": "^3.5.17"
  },
  "nx": {}
}
