{
  "name": "@vibraniumjs/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Ink UI and headless runner for Vibranium CLI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "vibranium": "./dist/bin/vibranium.js",
    "vm": "./dist/bin/vm.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin/vibranium.js",
    "dev": "tsx ./src/bin/vibranium.ts"
  },
  "keywords": [
    "vibranium",
    "cli",
    "ink",
    "terminal",
    "interactive"
  ],
  "author": "sarathm09",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarathm09/vibranium.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vibraniumjs/types": "^0.1.0",
    "@vibraniumjs/utils": "^0.1.0",
    "@vibraniumjs/core": "^0.1.0",
    "@vibraniumjs/plugins": "^0.1.0",
    "@vibraniumjs/http-client": "^0.1.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.0",
    "inquirer": "^12.1.0",
    "yaml": "^2.6.1",
    "ink-text-input": "^6.0.0",
    "ink-select-input": "^7.0.0",
    "ink-box": "^1.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "figures": "^6.1.0",
    "strip-ansi": "^7.1.0",
    "glob": "^11.0.0",
    "chokidar": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/react": "^18.3.17",
    "@types/glob": "^8.1.0",
    "@types/chokidar": "^2.1.3",
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "ink-testing-library": "^4.0.0"
  }
}