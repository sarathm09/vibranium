{
  "name": "cli",
  "projectType": "application",
  "sourceRoot": "packages/cli/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/cli/dist"
      },
      "dependsOn": ["^build"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/packages/cli"],
      "options": {
        "jestConfig": "packages/cli/jest.config.cjs",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/cli/**/*.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/cli"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/bin/vibranium.js",
        "cwd": "packages/cli"
      },
      "dependsOn": ["build"]
    }
  },
  "tags": ["type:application", "scope:cli"]
}