{
  "name": "@vibraniumjs/types",
  "version": "0.1.0",
  "description": "Shared TypeScript types for Vibranium CLI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vibranium",
    "types",
    "typescript",
    "api-testing"
  ],
  "author": "sarathm09",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarathm09/vibranium.git",
    "directory": "packages/types"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}