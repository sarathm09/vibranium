{
  "name": "ui",
  "projectType": "application",
  "sourceRoot": "packages/ui/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/ui/dist"
      },
      "configurations": {
        "production": {
          "mode": "production"
        },
        "development": {
          "mode": "development"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/packages/ui"],
      "options": {
        "jestConfig": "packages/ui/jest.config.cjs",
        "passWithNoTests": true
      },
      "configurations": {
        "watch": {
          "watch": true
        },
        "coverage": {
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/ui/**/*.{ts,tsx,js,jsx}"]
      },
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/ui"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "ui:build",
        "port": 3000,
        "host": "localhost"
      },
      "configurations": {
        "production": {
          "buildTarget": "ui:build:production",
          "hmr": false
        },
        "development": {
          "buildTarget": "ui:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "ui:build",
        "port": 3001
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Storybook not configured yet. Run: nx g @nx/storybook:configuration ui'"
      }
    }
  },
  "tags": ["type:application", "scope:ui"],
  "implicitDependencies": ["types"]
}