{
  "name": "@vibraniumjs/utils",
  "version": "0.1.0",
  "description": "Common utilities and helpers for Vibranium CLI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vibranium",
    "utils",
    "helpers",
    "file-system",
    "environment"
  ],
  "author": "sarathm09",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarathm09/vibranium.git",
    "directory": "packages/utils"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vibraniumjs/types": "^0.1.0",
    "yaml": "^2.6.1",
    "chalk": "^5.3.0",
    "uuid": "^11.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/uuid": "^11.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}